{
  "name": "next-pizza",
  "homepage": "https://filil2003.github.io/next-pizza/",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check --fix --error-on-warnings --no-errors-on-unmatched",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build-versel": "pnpm db:generate && pnpm build",
    "db:push": "zen db push --force-reset",
    "db:generate": "zen generate",
    "db:migrate": "zen migrate dev",
    "db:seed": "zen db seed"
  },
  "zenstack": {
    "seed": "tsx --env-file=.env ./zenstack/seed/index.ts"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-slider": "^1.4.7",
    "@tanstack/react-form-nextjs": "^1.33.5",
    "@tanstack/react-query": "^5.102.8",
    "@zenstackhq/orm": "^3.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.45.0",
    "next": "16.3.3",
    "nuqs": "^2.10.1",
    "pg": "^8.23.0",
    "react": "19.3.0",
    "react-dadata": "2.28.0-beta.0",
    "react-dom": "19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-devtools": "^0.9.3",
    "@tanstack/react-form-devtools": "^0.2.34",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@zenstackhq/cli": "^3.9.4",
    "lefthook": "^2.1.12",
    "slugify": "^1.6.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.21.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "^12.4.1",
      "onFail": "download"
    }
  }
}
